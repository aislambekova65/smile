# ============================================================
# Smile Estetic — пример переменных окружения
# Скопируй этот файл в .env и заполни своими значениями.
# .env в репозиторий НЕ коммитится (см. .gitignore).
# ============================================================

# ----- Django -----

# Сгенерируй командой:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string

# True — только для локальной разработки. На Vercel должно быть False.
DEBUG=True

# Через запятую, без пробелов. Локально можно localhost,127.0.0.1
# На Vercel: smile-sable.vercel.app,.vercel.app
ALLOWED_HOSTS=localhost,127.0.0.1

# Домены, с которых разрешены POST-формы (нужно для админ-логина при DEBUG=False).
# На Vercel: https://smile-sable.vercel.app,https://*.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# ----- База данных -----

# Локально можно оставить пустым — тогда возьмётся sqlite:///db.sqlite3.
#
# Для Supabase используй Connection Pooling (Transaction mode, port 6543) —
# его можно скопировать из Supabase Dashboard:
#   Project Settings -> Database -> Connection pooling -> Transaction.
#
# ВАЖНО: спецсимволы в пароле должны быть URL-encoded.
#   * -> %2A   # -> %23   $ -> %24   % -> %25   @ -> %40   / -> %2F   : -> %3A
#
# Пример (НЕ настоящий пароль):
# DATABASE_URL=postgresql://postgres.<project-ref>:<URL_ENCODED_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
